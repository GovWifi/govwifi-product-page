# --------------------------------------------------------------------
# GovWifi AI Support Assistant — local development environment
# --------------------------------------------------------------------
# Copy this file to `.env`, fill in the two API keys, then run:
#
#   docker compose build
#   docker compose up -d postgres redis
#   docker compose run --rm web bin/rails db:prepare
#   docker compose up web sidekiq
#
# The app         is at http://localhost:3000
# The widget demo is at http://localhost:3000/widget_demo
# The eval page   is at http://localhost:3000/evaluations
#
# Never commit `.env` — it is gitignored.
# --------------------------------------------------------------------


# --- REQUIRED — API keys -------------------------------------------

# Anthropic (chat provider). Get one at https://console.anthropic.com/
# Format: sk-ant-api03-...
ANTHROPIC_API_KEY=

# OpenAI (embedding provider — required for ingestion + retrieval).
# Get one at https://platform.openai.com/api-keys
# Format: sk-proj-... or sk-...
OPENAI_API_KEY=


# --- OPTIONAL — sensible defaults ----------------------------------

# Rails
RAILS_ENV=development

# Database + Redis (docker-compose provides these; override for host-mode)
DATABASE_URL=postgres://postgres:postgres@postgres:5432/chatbot_development
REDIS_URL=redis://redis:6379/0

# Which provider to use for chat vs embed (see docs/decisions.md ADR-006).
# Default is Claude for chat + OpenAI for embed.
LLM_CHAT_PROVIDER=anthropic
LLM_EMBED_PROVIDER=openai

# Model overrides (delete these lines to use the defaults in the adapters)
ANTHROPIC_CHAT_MODEL=claude-sonnet-4-6
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_EMBED_DIMENSIONS=1536

# Rate limiting on POST /api/chat (per IP)
CHAT_RATE_LIMIT=20
CHAT_RATE_PERIOD=60

# CORS — origins allowed to hit /api/chat.
# Add your product-page dev URL if it isn't already here.
CORS_ALLOWED_ORIGINS=http://localhost:4567,http://localhost:3000
