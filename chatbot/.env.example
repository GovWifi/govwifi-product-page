# Copy to `.env` for local development. Never commit `.env`.

# Rails
RAILS_ENV=development
# Generated by `bin/rails secret`; override in production via secrets manager.
# SECRET_KEY_BASE=

# Database
DATABASE_URL=postgres://postgres:postgres@postgres:5432/chatbot_development

# Redis (used by Sidekiq and optionally ActionCable)
REDIS_URL=redis://redis:6379/0

# LLM provider selection — one of: anthropic, openai
LLM_PROVIDER=anthropic

# Anthropic (default provider). Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-sonnet-4-6
ANTHROPIC_EMBED_MODEL=voyage-3

# OpenAI (fallback provider)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
