# Copy to `.env` for local development. Never commit `.env`.

# Rails
RAILS_ENV=development
# Generated by `bin/rails secret`; override in production via secrets manager.
# SECRET_KEY_BASE=

# Database
DATABASE_URL=postgres://postgres:postgres@postgres:5432/chatbot_development

# Redis (used by Sidekiq and optionally ActionCable)
REDIS_URL=redis://redis:6379/0

# Chat and embedding providers are independent (see docs/decisions.md ADR-006).
# Default: chat via Anthropic, embeddings via OpenAI.

LLM_CHAT_PROVIDER=anthropic
LLM_EMBED_PROVIDER=openai

# Anthropic (default chat provider). Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-sonnet-4-6

# OpenAI (default embedding provider; alt chat provider)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_EMBED_DIMENSIONS=1536
