<% content_for :title, "Evaluation Harness" %>

<div class="eval-page">
  <header class="eval-header">
    <h1>Evaluation Harness</h1>
    <p class="eval-lead">
      Test the assistant against a curated set of questions. Each row shows the latest run's
      answer, retrieved sources, latency, and human rating.
    </p>
  </header>

  <% if notice %>
    <div class="eval-notice"><%= notice %></div>
  <% end %>

  <section class="eval-add">
    <h2>Add a new evaluation</h2>

    <%= form_with model: @evaluation, local: true, class: "eval-form" do |f| %>
      <% if @evaluation.errors.any? %>
        <div class="eval-error">
          <p><strong>Fix the following before continuing:</strong></p>
          <ul>
            <% @evaluation.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="eval-field">
        <%= f.label :question, "Question" %>
        <%= f.text_area :question, rows: 2, placeholder: "How do I sign up for GovWifi?" %>
      </div>

      <div class="eval-field">
        <%= f.label :expected_answer, "Expected answer (free text; used as a human reference)" %>
        <%= f.text_area :expected_answer, rows: 3 %>
      </div>

      <div class="eval-field">
        <%= f.label "evaluation_expected_sources", "Expected sources (comma-separated relative paths)" %>
        <%= f.text_field :expected_sources, name: "evaluation[expected_sources][]",
                         placeholder: "source/get-started.html.erb, source/offer-govwifi.html.erb",
                         value: @evaluation.expected_sources&.join(", ") %>
      </div>

      <div class="eval-field">
        <%= f.label :notes, "Notes (optional)" %>
        <%= f.text_field :notes %>
      </div>

      <%= f.submit "Add evaluation", class: "eval-btn eval-btn-primary" %>
    <% end %>
  </section>

  <section class="eval-list">
    <h2>Evaluations (<%= @evaluations.size %>)</h2>

    <% if @evaluations.empty? %>
      <p class="eval-empty">No evaluations yet. Add one above.</p>
    <% else %>
      <table class="eval-table">
        <thead>
          <tr>
            <th>Status</th>
            <th>Question / Expected sources</th>
            <th>Latest answer</th>
            <th>Retrieved sources</th>
            <th>Latency</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <%= render partial: "evaluation_row", collection: @evaluations, as: :evaluation %>
        </tbody>
      </table>
    <% end %>
  </section>
</div>
